APP_ENV=development
APP_PORT=8080

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/joints_be?sslmode=disable

# Database container environment (for docker-compose)
DB_PORT=5432
DB_USER=postgres
DB_PASS=password
DB_NAME=joints_be

# Context Engine configuration
CONTEXT_RECENT_CHUNKS=5
CONTEXT_WORKER_INTERVAL=1s

# AI Provider: "mock" for offline testing / development, or "gemini"
AI_PROVIDER=mock
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash

# WebSocket configuration
WEBSOCKET_MAX_CONNECTIONS=100

